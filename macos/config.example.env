# Trae 每日签到配置（macOS）
# 权限应为 600；修改后不需要重装，下次触发自动生效。
# 不要把真实令牌提交进任何仓库或聊天记录。

API_HOST="api.trae.cn"

# 需要代理才能访问外网时填写，例如：
# PROXY_URL="http://127.0.0.1:10808"
# PROXY_URL="socks5h://127.0.0.1:1080"
PROXY_URL=""

WAIT_FOR_NETWORK_MINUTES="30"
RETRY_INTERVAL_SECONDS="30"
REQUEST_TIMEOUT_SECONDS="20"
NOTIFY_ON_FAILURE="1"
REQ_SOURCE="1"

# 令牌二选一：
#   1) USE_KEYCHAIN="1"：从“钥匙串”读取，配置里不落明文（推荐）
#   2) USE_KEYCHAIN="0" + AUTH_TOKEN：明文保存在本文件（权限 600）
USE_KEYCHAIN="0"
KEYCHAIN_SERVICE="trae-checkin-token"
AUTH_TOKEN=""
